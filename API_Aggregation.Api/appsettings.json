{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Jwt": {
    "Key": "ThisIsASuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "API-Aggregation-Auth-Service",
    "Audience": "API-Aggregation-Services",
    "ExpiryMinutes": 30
  },
  "Auth": {
    "Users": [
      { "Username": "demo", "Password": "demo-password" }
    ]
  },
  "ExternalApis": {
    "OpenWeatherMap": {
      "Enabled": true,
      "BaseUrl": "https://api.openweathermap.org/",
      "ApiKey": "",
      "MaxItems": 16,
      "CacheDurationSeconds": 600,
      "StaleCacheDurationMinutes": 120
    },
    "OpenMeteo": {
      "Enabled": true,
      "BaseUrl": "https://api.open-meteo.com/",
      "MaxItems": 7,
      "CacheDurationSeconds": 900,
      "StaleCacheDurationMinutes": 180,
      "Settings": {
        "GeocodingUrl": "https://geocoding-api.open-meteo.com/v1/search"
      }
    },
    "HackerNews": {
      "Enabled": true,
      "BaseUrl": "https://hn.algolia.com/",
      "MaxItems": 20,
      "CacheDurationSeconds": 300,
      "StaleCacheDurationMinutes": 60
    },
    "GitHub": {
      "Enabled": true,
      "BaseUrl": "https://api.github.com/",
      "ApiKey": "",
      "MaxItems": 20,
      "CacheDurationSeconds": 600,
      "StaleCacheDurationMinutes": 120
    }
  },
  "Statistics": {
    "FastThresholdMs": 100,
    "SlowThresholdMs": 200,
    "SampleRetentionMinutes": 60,
    "MaxSamplesPerApi": 10000
  },
  "AnomalyDetection": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "WindowMinutes": 5,
    "ThresholdPercent": 50,
    "MinimumSamples": 3
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5174" ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5281",
        "Protocols": "Http1"
      }
    }
  }
}
